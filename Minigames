function MG.OpenBank()
	if not MG._data then MG.Load() end
	local win = makeWindow("bank", "R8 Bank", Vector2.new(340, 320))
	local body = win.body
	for _, c in ipairs(body:GetChildren()) do
		c:Destroy()
	end

	local balLbl = label(body, {
		Text = "Balance: " .. moneyLabel(MG._data.balance),
		Size = UDim2.new(1, 0, 0, 22),
		Font = Enum.Font.GothamBold,
		TextSize = 16,
	})
	local loanLbl = label(body, {
		Text = "Loan owed: " .. moneyLabel(MG._data.loanOwed),
		Position = UDim2.new(0, 0, 0, 26),
		Size = UDim2.new(1, 0, 0, 20),
		TextColor3 = Color3.fromRGB(255, 180, 120),
	})
	local info = label(body, {
		Text = "Interest: "
			.. tostring(math.floor((MG._data.loanRate or 0.15) * 100))
			.. "%  ·  Strikes: "
			.. tostring(MG._data.loanStrikes or 0),
		Position = UDim2.new(0, 0, 0, 48),
		Size = UDim2.new(1, 0, 0, 18),
		TextSize = 12,
		TextColor3 = Color3.fromRGB(150, 160, 190),
	})

	local status = label(body, {
		Text = "",
		Position = UDim2.new(0, 0, 0, 72),
		Size = UDim2.new(1, 0, 0, 18),
		TextSize = 12,
		TextColor3 = Color3.fromRGB(140, 220, 160),
	})

	local function refresh()
		balLbl.Text = "Balance: " .. moneyLabel(MG._data.balance)
		loanLbl.Text = "Loan owed: " .. moneyLabel(MG._data.loanOwed)
		info.Text = "Interest: "
			.. tostring(math.floor((MG._data.loanRate or 0.15) * 100))
			.. "%  ·  Strikes: "
			.. tostring(MG._data.loanStrikes or 0)
	end

	local amounts = { 100, 250, 500, 1000 }
	for i, amt in ipairs(amounts) do
		button(body, {
			Text = "Borrow " .. moneyLabel(amt),
			Size = UDim2.new(0.48, -4, 0, 32),
			Position = UDim2.new((i % 2 == 1) and 0 or 0.52, 0, 0, 100 + math.floor((i - 1) / 2) * 40),
			BackgroundColor3 = Color3.fromRGB(70, 130, 90),
		}, function()
			local rate = MG._data.loanRate or 0.15
			-- higher strikes → worse rate
			local effective = rate + (MG._data.loanStrikes or 0) * 0.05
			local owedAdd = math.floor(amt * (1 + effective))
			MG._data.loanPrincipal += amt
			MG._data.loanOwed += owedAdd
			addCash(amt)
			status.Text = "Borrowed " .. moneyLabel(amt) .. " — owe +" .. moneyLabel(owedAdd)
			status.TextColor3 = Color3.fromRGB(255, 200, 120)
			refresh()
		end)
	end

	button(body, {
		Text = "Pay $100",
		Size = UDim2.new(0.48, -4, 0, 32),
		Position = UDim2.new(0, 0, 0, 190),
		BackgroundColor3 = Color3.fromRGB(90, 116, 253),
	}, function()
		local pay = math.min(100, MG._data.loanOwed)
		if pay <= 0 then
			status.Text = "No loan to pay."
			return
		end
		if not trySpend(pay) then
			status.Text = "Not enough cash."
			status.TextColor3 = Color3.fromRGB(255, 100, 100)
			return
		end
		MG._data.loanOwed -= pay
		if MG._data.loanOwed <= 0 then
			MG._data.loanOwed = 0
			MG._data.loanPrincipal = 0
			MG._data.loanStrikes = 0
			MG._data.loanRate = 0.15
			status.Text = "Loan cleared!"
			status.TextColor3 = Color3.fromRGB(120, 255, 140)
		else
			status.Text = "Paid " .. moneyLabel(pay)
			status.TextColor3 = Color3.fromRGB(140, 220, 160)
		end
		MG.Save()
		refresh()
	end)

	button(body, {
		Text = "Pay ALL",
		Size = UDim2.new(0.48, -4, 0, 32),
		Position = UDim2.new(0.52, 0, 0, 190),
		BackgroundColor3 = Color3.fromRGB(90, 116, 253),
	}, function()
		local pay = MG._data.loanOwed
		if pay <= 0 then
			status.Text = "No loan to pay."
			return
		end
		if not trySpend(pay) then
			status.Text = "Need " .. moneyLabel(pay) .. " to clear."
			status.TextColor3 = Color3.fromRGB(255, 100, 100)
			return
		end
		MG._data.loanOwed = 0
		MG._data.loanPrincipal = 0
		MG._data.loanStrikes = 0
		MG._data.loanRate = 0.15
		MG.Save()
		status.Text = "Loan cleared!"
		status.TextColor3 = Color3.fromRGB(120, 255, 140)
		refresh()
	end)

	button(body, {
		Text = "Compound interest (simulate late)",
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.new(0, 0, 0, 232),
		BackgroundColor3 = Color3.fromRGB(140, 70, 70),
	}, function()
		if MG._data.loanOwed <= 0 then
			status.Text = "No active loan."
			return
		end
		local rate = (MG._data.loanRate or 0.15) + 0.05
		MG._data.loanOwed = math.floor(MG._data.loanOwed * (1 + rate))
		MG._data.loanStrikes = (MG._data.loanStrikes or 0) + 1
		MG._data.loanRate = math.min(0.5, (MG._data.loanRate or 0.15) + 0.02)
		MG.Save()
		status.Text = "Interest applied. Owed rose."
		status.TextColor3 = Color3.fromRGB(255, 140, 100)
		refresh()
	end)

	refresh()
end

