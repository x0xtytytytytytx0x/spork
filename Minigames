local function fmt(n)
	n = tonumber(n) or 0
	local neg = n < 0
	n = math.abs(n)
	local suffixes = {
		{ 1e33, "Dc" }, { 1e30, "No" }, { 1e27, "Oc" }, { 1e24, "Sp" },
		{ 1e21, "Sx" }, { 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" },
		{ 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" },
	}
	for _, suf in ipairs(suffixes) do
		if n >= suf[1] then
			local v = n / suf[1]
			local s
			if v >= 100 then s = string.format("%.0f", v)
			elseif v >= 10 then s = string.format("%.1f", v):gsub("%.0$", "")
			else s = string.format("%.2f", v):gsub("0+$", ""):gsub("%.$", "") end
			return (neg and "-" or "") .. s .. suf[2]
		end
	end
	-- under 1000: whole cookies only (no 0.00 clutter)
	return (neg and "-" or "") .. string.format("%.0f", math.floor(n + 1e-9))
end
local function moneyLabel(n)
