		{ "Connect 4", col(th, "AccentRed"), MG.OpenConnect4 },
		{ "RPS", Color3.fromRGB(80, 140, 160), MG.OpenRPS },
		{ "Coin Flip", Color3.fromRGB(160, 130, 60), MG.OpenCoinFlip },
		{ "Higher/Lower", Color3.fromRGB(90, 110, 150), MG.OpenHigherLower },
		{ "Number Guess", Color3.fromRGB(100, 120, 90), MG.OpenNumberGuess },
		{ "Hangman", Color3.fromRGB(140, 90, 110), MG.OpenHangman },
		{ "Wordle", Color3.fromRGB(70, 130, 100), MG.OpenWordle },
		{ "Dots & Boxes", Color3.fromRGB(110, 100, 150), MG.OpenDotsBoxes },
	}
	local y = 40
	for _, g in ipairs(games) do
		button(body, {
			Text = g[1], Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 0, y),
