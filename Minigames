function MG.OpenBank()
	if not MG._data then MG.Load() end
	local th = detectTheme()
	local win = makeWindow("bank", "Bank", Vector2.new(300, 300))
	local body = win.body
	for _, c in ipairs(body:GetChildren()) do c:Destroy() end
	local balLbl = label(body, { Text = "Bal " .. moneyLabel(MG._data.balance), Size = UDim2.new(1, 0, 0, 18), Font = Enum.Font.GothamBold })
	local loanLbl = label(body, { Text = "Owed " .. moneyLabel(MG._data.loanOwed), Position = UDim2.new(0, 0, 0, 20), Size = UDim2.new(1, 0, 0, 16), TextColor3 = col(th, "AccentRed"), TextSize = 12 })
	local status = label(body, { Text = "", Position = UDim2.new(0, 0, 0, 40), Size = UDim2.new(1, 0, 0, 16), TextSize = 11, TextColor3 = col(th, "SubText") })
	watchBalance("bank", function(b) balLbl.Text = "Bal " .. moneyLabel(b) end)
	local function refresh()
		balLbl.Text = "Bal " .. moneyLabel(MG._data.balance)
		loanLbl.Text = "Owed " .. moneyLabel(MG._data.loanOwed) .. "  |  rate " .. tostring(math.floor((MG._data.loanRate or 0.15) * 100)) .. "%"
	end
	local amounts = { 100, 250, 500, 1000 }
	for i, amt in ipairs(amounts) do
		button(body, {
			Text = "Borrow " .. moneyLabel(amt), Size = UDim2.new(0.48, -3, 0, 28),
			Position = UDim2.new((i % 2 == 1) and 0 or 0.52, 0, 0, 62 + math.floor((i - 1) / 2) * 34),
			BackgroundColor3 = Color3.fromRGB(50, 120, 80), TextSize = 11,
		}, function()
			local effective = (MG._data.loanRate or 0.15) + (MG._data.loanStrikes or 0) * 0.05
			local owedAdd = math.floor(amt * (1 + effective))
			MG._data.loanPrincipal += amt
			MG._data.loanOwed += owedAdd
			addCash(amt)
			status.Text = "Got " .. moneyLabel(amt) .. " owe +" .. moneyLabel(owedAdd)
			refresh()
		end)
	end
	button(body, { Text = "Pay $100", Size = UDim2.new(0.48, -3, 0, 28), Position = UDim2.new(0, 0, 0, 140), BackgroundColor3 = col(th, "AccentBlue"), TextSize = 11 }, function()
		local pay = math.min(100, MG._data.loanOwed)
		if pay <= 0 then status.Text = "Nothing owed." return end
		if not trySpend(pay) then status.Text = "Need cash." return end
		MG._data.loanOwed -= pay
		if MG._data.loanOwed <= 0 then
			MG._data.loanOwed, MG._data.loanPrincipal, MG._data.loanStrikes, MG._data.loanRate = 0, 0, 0, 0.15
			status.Text = "Cleared!"
		else status.Text = "Paid " .. moneyLabel(pay) end
		MG.Save()
		refresh()
	end)
	button(body, { Text = "Pay ALL", Size = UDim2.new(0.48, -3, 0, 28), Position = UDim2.new(0.52, 0, 0, 140), BackgroundColor3 = col(th, "AccentBlue"), TextSize = 11 }, function()
		local pay = MG._data.loanOwed
		if pay <= 0 then status.Text = "Nothing owed." return end
		if not trySpend(pay) then status.Text = "Need " .. moneyLabel(pay) return end
		MG._data.loanOwed, MG._data.loanPrincipal, MG._data.loanStrikes, MG._data.loanRate = 0, 0, 0, 0.15
		MG.Save()
		status.Text = "Cleared!"
		refresh()
	end)
	button(body, { Text = "Late fee (compound)", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 0, 178), BackgroundColor3 = col(th, "AccentRed"), TextSize = 11 }, function()
		if MG._data.loanOwed <= 0 then status.Text = "No loan." return end
		local rate = (MG._data.loanRate or 0.15) + 0.05
		MG._data.loanOwed = math.floor(MG._data.loanOwed * (1 + rate))
		MG._data.loanStrikes = (MG._data.loanStrikes or 0) + 1
		MG._data.loanRate = math.min(0.5, (MG._data.loanRate or 0.15) + 0.02)
		MG.Save()
		status.Text = "Interest applied."
		refresh()
	end)
	refresh()
end

