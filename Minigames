function MG.OpenConnect4()
	if not MG._data then MG.Load() end
	local th = detectTheme()
	local COLS, ROWS = 7, 6
	local win = makeWindow("c4", "Connect 4", Vector2.new(320, 360))
	local body = win.body
	for _, c in ipairs(body:GetChildren()) do c:Destroy() end
	local bb = makeBalBet(body, "c4", 40)
	local over = false
	local board = {}
	for c = 1, COLS do board[c] = {} for r = 1, ROWS do board[c][r] = 0 end end
	local cells = {}
	local msg = label(body, { Text = "Pick a column.", Position = UDim2.new(0, 0, 0, bb.contentY), Size = UDim2.new(1, 0, 0, 14), TextSize = 11, TextColor3 = col(th, "SubText") })
	local grid = Instance.new("Frame")
	grid.BackgroundColor3 = col(th, "Panel")
	grid.Position = UDim2.new(0.5, -140, 0, bb.contentY + 18)
	grid.Size = UDim2.fromOffset(280, 200)
	grid.BorderSizePixel = 0
	grid.Parent = body
	corner(grid, 6)
	local function cellColor(v)
		if v == 1 then return col(th, "AccentBlue") end
		if v == 2 then return col(th, "AccentRed") end
		return col(th, "Background")
	end
	local function paint()
		for c = 1, COLS do for r = 1, ROWS do
			local f = cells[c] and cells[c][r]
			if f then f.BackgroundColor3 = cellColor(board[c][r]) end
		end end
	end
	local function drop(col, who)
		for r = 1, ROWS do if board[col][r] == 0 then board[col][r] = who return r end end
	end
	local function checkWin(who)
		local dirs = { {1,0},{0,1},{1,1},{1,-1} }
		for c = 1, COLS do for r = 1, ROWS do
			if board[c][r] == who then
				for _, d in ipairs(dirs) do
					local ok = true
					for k = 1, 3 do
						local nc, nr = c + d[1] * k, r + d[2] * k
						if nc < 1 or nc > COLS or nr < 1 or nr > ROWS or board[nc][nr] ~= who then ok = false break end
					end
					if ok then return true end
				end
			end
		end end
		return false
	end
	local function boardFull()
		for c = 1, COLS do if board[c][ROWS] == 0 then return false end end
		return true
	end
	local function aiPlay()
		local function tryWho(who)
			for c = 1, COLS do
				local r = drop(c, who)
				if r then local w = checkWin(who) board[c][r] = 0 if w then return c end end
			end
		end
		local c = tryWho(2) or tryWho(1)
		if not c then
			local opts = {}
			for i = 1, COLS do if board[i][ROWS] == 0 then table.insert(opts, i) end end
			if #opts > 0 then c = opts[math.random(1, #opts)] end
		end
		if c then drop(c, 2) end
		paint()
	end
	local function finish(result)
		over = true
		local bet = bb.getBet()
		if result == "win" then payoutWin(bet) msg.Text = "Win +" .. moneyLabel(bet) msg.TextColor3 = Color3.fromRGB(120, 255, 140)
		elseif result == "lose" then msg.Text = "Lose" msg.TextColor3 = col(th, "AccentRed")
		else payoutPush(bet) msg.Text = "Draw" end
	end
	local cs, pad = 34, 3
	for c = 1, COLS do
		cells[c] = {}
		for r = 1, ROWS do
			local f = Instance.new("Frame")
			f.Size = UDim2.fromOffset(cs, cs)
			f.Position = UDim2.fromOffset(6 + (c - 1) * (cs + pad), 6 + (ROWS - r) * (cs + pad))
			f.BackgroundColor3 = cellColor(0)
			f.BorderSizePixel = 0
			f.Parent = grid
			corner(f, 16)
			cells[c][r] = f
		end
		button(body, {
			Text = tostring(c), Size = UDim2.fromOffset(cs, 18),
			Position = UDim2.new(0.5, -140 + 6 + (c - 1) * (cs + pad), 0, bb.contentY + 222),
			BackgroundColor3 = col(th, "PanelLight"), TextColor3 = col(th, "Text"), TextSize = 10,
		}, function()
			if over then return end
			if not drop(c, 1) then return end
			paint()
			if checkWin(1) then finish("win") return end
			if boardFull() then finish("draw") return end
			aiPlay()
			if checkWin(2) then finish("lose") return end
			if boardFull() then finish("draw") end
		end)
	end
	button(body, { Text = "New game", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 1, -26), BackgroundColor3 = col(th, "AccentBlue") }, function()
		if not trySpend(bb.getBet()) then msg.Text = "Need cash." return end
		for c = 1, COLS do for r = 1, ROWS do board[c][r] = 0 end end
		over = false
		paint()
		msg.Text = "Your turn."
		msg.TextColor3 = col(th, "SubText")
	end)
end

