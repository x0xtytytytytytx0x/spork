	local customBorrow = button(body, {
		Text = "Borrow", Size = UDim2.new(0.38, -3, 0, 28), Position = UDim2.new(0.62, 0, 0, 262),
		BackgroundColor3 = Color3.fromRGB(50, 120, 80), TextSize = 11,
	}, function()
		local n = tonumber((borrowBox.Text or ""):gsub("[^%d%.]", ""))
		doBorrow(n)
	end)
	table.insert(borrowBtns, customBorrow)

	local payAll = button(body, {
		Text = "Pay ALL loans", Size = UDim2.new(0.48, -3, 0, 28), Position = UDim2.new(0, 0, 0, 298),
		BackgroundColor3 = col(th, "AccentBlue"), TextSize = 11,
