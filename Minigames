local function getBuildMult(id)
	local m = 1
	if not MG._data then return m end
	for _, u in ipairs(UPGRADES) do
		if MG._data.upgrades[u.id] and u.buildMult and u.buildMult[id] then m *= u.buildMult[id] end
	end
	return m
end
local function getCpsMult()
	local m = MG._data and MG._data.prestigeMult or 1
	if not MG._data then return m end
	for _, u in ipairs(UPGRADES) do
		if MG._data.upgrades[u.id] and u.cpsMult then m *= u.cpsMult end
	end
	return m
end
local function getClickMult()
	local m = 1
	if not MG._data then return m end
	for _, u in ipairs(UPGRADES) do
		if MG._data.upgrades[u.id] and u.clickMult then m *= u.clickMult end
	end
	return m
end
local function computeCPS()
	if not MG._data then MG.Load() end
	local total = 0
	for _, b in ipairs(BUILDINGS) do
		total += (MG._data.buildings[b.id] or 0) * b.cps * getBuildMult(b.id)
	end
	return total * getCpsMult()
end
local function computeClickPower()
	if not MG._data then MG.Load() end
	local base, extra, nonCursor = 1, 0, 0
	for _, b in ipairs(BUILDINGS) do
		if b.id ~= "cursor" then nonCursor += (MG._data.buildings[b.id] or 0) end
	end
	for _, u in ipairs(UPGRADES) do
		if MG._data.upgrades[u.id] and u.clickAdd then extra += u.clickAdd * nonCursor end
	end
	local cps = computeCPS()
	local mouseBonus = 0
	for _, u in ipairs(UPGRADES) do
		if MG._data.upgrades[u.id] and u.mousePct then mouseBonus += cps * u.mousePct end
	end
	return (base + extra + mouseBonus) * getClickMult() * (MG._data.prestigeMult or 1)
end
