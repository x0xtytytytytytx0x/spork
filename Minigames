		BackgroundColor3 = Color3.fromRGB(120, 90, 180),
	}, function()
		MG.OpenTicTacToe()
	end)

	button(body, {
		Text = "Refresh balance",
		Size = UDim2.new(1, 0, 0, 28),
		Position = UDim2.new(0, 0, 0, 200),
		BackgroundColor3 = Color3.fromRGB(50, 55, 70),
		TextSize = 12,
	}, function()
		MG.Load()
		bal.Text = "Balance: " .. moneyLabel(MG._data.balance)
	end)
end

