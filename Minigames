function MG.BindMainWindow(window)
	MG._mainWindow = window
	if window and type(window.Theme) == "table" then MG._theme = window.Theme end
	task.spawn(function()
		while MG._mainWindow == window do
			local hidden = window.Hidden == true or window.Destroyed == true
			pcall(function() if window.ScreenGui and window.ScreenGui.Enabled == false then hidden = true end end)
			if hidden ~= MG._suppressed then
				MG._suppressed = hidden
				for _, w in pairs(MG._windows) do if w.gui then w.gui.Enabled = not hidden end end
			end
			if window.Theme and window.Theme ~= MG._theme then MG._theme = window.Theme end
			task.wait(0.2)
		end
	end)
end
