	local active = false
	local msg = label(body, { Text = "Start, then claim edges.", Position = UDim2.new(0, 0, 0, bb.contentY), Size = UDim2.new(1, 0, 0, 16), TextSize = 11, TextColor3 = col(th, "SubText") })
	local scoreLbl = label(body, { Text = "You 0 - 0 AI", Position = UDim2.new(0, 0, 0, bb.contentY + 16), Size = UDim2.new(1, 0, 0, 14), TextSize = 11 })
	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Position = UDim2.new(0.5, -90, 0, bb.contentY + 36)
	grid.Size = UDim2.fromOffset(180, 180)
	grid.Parent = body
	local edgeBtns = {}
	local function countBox(r, c)
		return (hEdges[r][c] > 0 and 1 or 0) + (hEdges[r + 1][c] > 0 and 1 or 0) + (vEdges[r][c] > 0 and 1 or 0) + (vEdges[r][c + 1] > 0 and 1 or 0)
	end
	local function claim(isH, r, c, who)
		if isH then
			if hEdges[r][c] ~= 0 then return false end
			hEdges[r][c] = who
		else
			if vEdges[r][c] ~= 0 then return false end
			vEdges[r][c] = who
		end
		local got = false
		for br = 1, N do
			for bc = 1, N do
				if boxes[br][bc] == 0 and countBox(br, bc) == 4 then
					boxes[br][bc] = who
					scores[who] += 1
					got = true
				end
			end
		end
		scoreLbl.Text = "You " .. scores[1] .. " - " .. scores[2] .. " AI"
		return true, got
	end
	local function remaining()
		local n = 0
		for r = 1, N + 1 do for c = 1, N do if hEdges[r][c] == 0 then n += 1 end end end
		for r = 1, N do for c = 1, N + 1 do if vEdges[r][c] == 0 then n += 1 end end end
		return n
	end
	local function finishIfDone()
		if remaining() > 0 then return end
		active = false
		local bet = bb.getBet()
		if scores[1] > scores[2] then
			payoutWin(bet)
			msg.Text = "You win +" .. moneyLabel(bet)
			msg.TextColor3 = Color3.fromRGB(120, 255, 140)
		elseif scores[1] < scores[2] then
			msg.Text = "AI wins."
			msg.TextColor3 = col(th, "AccentRed")
		else
			payoutPush(bet)
			msg.Text = "Draw"
		end
	end
	local function aiTurn()
		-- complete a box if possible else random
		for r = 1, N + 1 do
			for c = 1, N do
				if hEdges[r][c] == 0 then
					hEdges[r][c] = 2
					local would = false
					for br = 1, N do for bc = 1, N do if boxes[br][bc] == 0 and countBox(br, bc) == 4 then would = true end end end
					hEdges[r][c] = 0
					if would then
						local _, got = claim(true, r, c, 2)
						if not got then turn = 1 else aiTurn() end
						finishIfDone()
						return
					end
				end
			end
		end
		local opts = {}
		for r = 1, N + 1 do for c = 1, N do if hEdges[r][c] == 0 then table.insert(opts, { true, r, c }) end end end
		for r = 1, N do for c = 1, N + 1 do if vEdges[r][c] == 0 then table.insert(opts, { false, r, c }) end end end
		if #opts == 0 then finishIfDone() return end
		local o = opts[math.random(1, #opts)]
		local _, got = claim(o[1], o[2], o[3], 2)
		if got then aiTurn() else turn = 1 end
		finishIfDone()
	end
	local function rebuildEdges()
		for _, ch in ipairs(grid:GetChildren()) do ch:Destroy() end
		local cell = 50
		for r = 1, N + 1 do
			for c = 1, N do
				local b = button(grid, {
					Text = "", Size = UDim2.fromOffset(cell - 8, 8),
					Position = UDim2.fromOffset((c - 1) * cell + 8, (r - 1) * cell),
					BackgroundColor3 = hEdges[r][c] == 0 and col(th, "PanelLight") or (hEdges[r][c] == 1 and col(th, "AccentBlue") or col(th, "AccentRed")),
				}, function()
					if not active or turn ~= 1 or hEdges[r][c] ~= 0 then return end
					local _, got = claim(true, r, c, 1)
					b.BackgroundColor3 = col(th, "AccentBlue")
					if got then turn = 1 else turn = 2 aiTurn() end
					finishIfDone()
				end)
			end
		end
		for r = 1, N do
			for c = 1, N + 1 do
				local b = button(grid, {
					Text = "", Size = UDim2.fromOffset(8, cell - 8),
					Position = UDim2.fromOffset((c - 1) * cell, (r - 1) * cell + 8),
					BackgroundColor3 = vEdges[r][c] == 0 and col(th, "PanelLight") or (vEdges[r][c] == 1 and col(th, "AccentBlue") or col(th, "AccentRed")),
				}, function()
					if not active or turn ~= 1 or vEdges[r][c] ~= 0 then return end
					local _, got = claim(false, r, c, 1)
					b.BackgroundColor3 = col(th, "AccentBlue")
					if got then turn = 1 else turn = 2 aiTurn() end
					finishIfDone()
				end)
			end
		end
	end
	rebuildEdges()
	button(body, { Text = "New game", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 1, -26), BackgroundColor3 = col(th, "AccentBlue") }, function()
		if not trySpend(bb.getBet()) then msg.Text = "Need cash." return end
		for r = 1, N + 1 do for c = 1, N do hEdges[r][c] = 0 end end
		for r = 1, N do for c = 1, N + 1 do vEdges[r][c] = 0 end for c = 1, N do boxes[r][c] = 0 end end
		scores = { 0, 0 }
		turn, active = 1, true
		scoreLbl.Text = "You 0 - 0 AI"
		msg.Text = "Claim edges. Complete boxes."
		msg.TextColor3 = col(th, "SubText")
		rebuildEdges()
	end)
end

