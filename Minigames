--[[
	R8 Minigames v1.2
	https://raw.githubusercontent.com/x0xtytytytytytx0x/spork/refs/heads/main/Minigames
	Balance synced across all open windows. Bet+/- on every game.
	Win pays 2x stake (stake returned + equal profit).
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local SAVE_PATH = "R8TW0/minigames.json"
local STARTING_CASH = 1000
local DISPLAY_ORDER = 2147483646

local MG = {
	Version = "1.2",
	_windows = {},
	_data = nil,
	_theme = nil,
	_mainWindow = nil,
	_suppressed = false,
	_balListeners = {},
}

local FALLBACK = {
	Background = Color3.fromRGB(18, 20, 28),
	Sidebar = Color3.fromRGB(28, 32, 44),
	Panel = Color3.fromRGB(36, 42, 58),
	PanelLight = Color3.fromRGB(50, 58, 78),
	AccentRed = Color3.fromRGB(240, 70, 80),
	AccentBlue = Color3.fromRGB(90, 116, 253),
	Text = Color3.fromRGB(230, 235, 255),
	SubText = Color3.fromRGB(140, 150, 180),
	Stroke = Color3.fromRGB(90, 116, 253),
}

local function col(t, key)
	if type(t) == "table" and typeof(t[key]) == "Color3" then return t[key] end
	return FALLBACK[key]
end

local function detectTheme()
	if type(MG._theme) == "table" and typeof(MG._theme.Background) == "Color3" then return MG._theme end
	if MG._mainWindow and type(MG._mainWindow.Theme) == "table" then return MG._mainWindow.Theme end
	return FALLBACK
end

function MG.SetTheme(theme)
	if type(theme) == "table" then MG._theme = theme end
end

function MG.BindMainWindow(window)
	MG._mainWindow = window
	if window and type(window.Theme) == "table" then MG._theme = window.Theme end
	task.spawn(function()
		while MG._mainWindow == window do
			local hidden = window.Hidden == true or window.Destroyed == true
			pcall(function()
				if window.ScreenGui and window.ScreenGui.Enabled == false then hidden = true end
			end)
			if hidden ~= MG._suppressed then
				MG._suppressed = hidden
				for _, w in pairs(MG._windows) do
					if w.gui then w.gui.Enabled = not hidden end
				end
			end
			if window.Theme and window.Theme ~= MG._theme then MG._theme = window.Theme end
			task.wait(0.2)
		end
	end)
end

local function fsOk()
	return typeof(writefile) == "function" and typeof(readfile) == "function"
end
local function ensureRoot()
	if not fsOk() then return end
	pcall(function()
		if typeof(makefolder) == "function" and (typeof(isfolder) ~= "function" or not isfolder("R8TW0")) then
			makefolder("R8TW0")
		end
	end)
end
local function defaultData()
	return {
		balance = STARTING_CASH, loanPrincipal = 0, loanOwed = 0, loanRate = 0.15, loanStrikes = 0,
		stats = {}, lastSave = os.time(),
	}
end
function MG.Load()
	local d = defaultData()
	if fsOk() then
		pcall(function()
			if typeof(isfile) == "function" and not isfile(SAVE_PATH) then return end
			local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(SAVE_PATH)) end)
			if ok and type(decoded) == "table" then
				for k, v in pairs(decoded) do
					if k == "stats" and type(v) == "table" then
						d.stats = d.stats or {}
						for sk, sv in pairs(v) do d.stats[sk] = sv end
					else d[k] = v end
				end
			end
		end)
	end
	d.balance = math.max(0, math.floor(tonumber(d.balance) or STARTING_CASH))
	d.loanOwed = math.max(0, tonumber(d.loanOwed) or 0)
	d.loanPrincipal = math.max(0, tonumber(d.loanPrincipal) or 0)
	d.stats = d.stats or {}
	MG._data = d
	return d
end
function MG.Save()
	if not MG._data then MG.Load() end
	MG._data.lastSave = os.time()
	if not fsOk() then return false end
	ensureRoot()
	return pcall(function() writefile(SAVE_PATH, HttpService:JSONEncode(MG._data)) end) == true
end
function MG.GetBalance()
	if not MG._data then MG.Load() end
	return MG._data.balance
end

local function fireBalance()
	local b = MG.GetBalance()
	for _, fn in pairs(MG._balListeners) do
		pcall(fn, b)
	end
end

local function watchBalance(id, fn)
	MG._balListeners[id] = fn
end

local function addCash(n)
	if not MG._data then MG.Load() end
	MG._data.balance = math.max(0, math.floor(MG._data.balance + (tonumber(n) or 0)))
	MG.Save()
	fireBalance()
	return MG._data.balance
end
local function trySpend(n)
	n = math.floor(tonumber(n) or 0)
	if n <= 0 then return false end
	if not MG._data then MG.Load() end
	if MG._data.balance < n then return false end
	MG._data.balance -= n
	MG.Save()
	fireBalance()
	return true
end
local function moneyLabel(n)
	return "$" .. tostring(math.floor(tonumber(n) or 0))
end
-- win = 2x stake returned (profit = stake)
local function payoutWin(bet)
	addCash(bet * 2)
end
local function payoutPush(bet)
	addCash(bet)
end

local function corner(p, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = p
	return c
end
local function stroke(p, color, t)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = t or 1
	s.Parent = p
	return s
end
local function label(parent, props)
	local th = detectTheme()
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamMedium
	l.TextSize = 13
	l.TextColor3 = col(th, "Text")
	l.TextXAlignment = Enum.TextXAlignment.Left
	for k, v in pairs(props or {}) do l[k] = v end
	l.Parent = parent
	return l
end
local function button(parent, props, cb)
	local th = detectTheme()
	local b = Instance.new("TextButton")
	b.AutoButtonColor = true
	b.Font = Enum.Font.GothamBold
	b.TextSize = 12
	b.TextColor3 = Color3.new(1, 1, 1)
	b.BackgroundColor3 = col(th, "AccentBlue")
	b.BorderSizePixel = 0
	for k, v in pairs(props or {}) do b[k] = v end
	corner(b, 6)
	b.Parent = parent
	if cb then b.MouseButton1Click:Connect(cb) end
	return b
end

local function makeWindow(id, titleText, size)
	local th = detectTheme()
	if MG._windows[id] and MG._windows[id].gui and MG._windows[id].gui.Parent then
		MG._windows[id].gui.Enabled = not MG._suppressed
		return MG._windows[id]
	end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui")
	local gui = Instance.new("ScreenGui")
	gui.Name = "R8MG_" .. id
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = DISPLAY_ORDER
	gui.Enabled = not MG._suppressed
	gui.Parent = pg
	local w, h = size.X, size.Y
	local main = Instance.new("Frame")
	main.Name = "Main"
	main.Size = UDim2.fromOffset(w, h)
	main.Position = UDim2.new(0.5, -w / 2 + (#id % 5) * 10, 0.5, -h / 2 + (#id % 3) * 8)
	main.BackgroundColor3 = col(th, "Background")
	main.BorderSizePixel = 0
	main.Active = true
	main.Parent = gui
	corner(main, 10)
	stroke(main, col(th, "Stroke"), 1.5)
	local top = Instance.new("Frame")
	top.Name = "TopBar"
	top.Size = UDim2.new(1, 0, 0, 32)
	top.BackgroundColor3 = col(th, "Sidebar")
	top.BorderSizePixel = 0
	top.Parent = main
	corner(top, 10)
	local topCover = Instance.new("Frame")
	topCover.BackgroundColor3 = top.BackgroundColor3
	topCover.BorderSizePixel = 0
	topCover.Position = UDim2.new(0, 0, 1, -10)
	topCover.Size = UDim2.new(1, 0, 0, 10)
	topCover.Parent = top
	local accent = Instance.new("Frame")
	accent.BackgroundColor3 = col(th, "AccentBlue")
	accent.BorderSizePixel = 0
	accent.Position = UDim2.new(0, 0, 1, -2)
	accent.Size = UDim2.new(1, 0, 0, 2)
	accent.Parent = top
	local title = label(top, {
		Text = titleText, Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -80, 1, 0),
		Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = col(th, "Text"),
	})
	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.new(0, 10, 0, 38)
	body.Size = UDim2.new(1, -20, 1, -46)
	body.Parent = main
	local minimized = false
	button(top, {
		Text = "-", Size = UDim2.fromOffset(24, 20), Position = UDim2.new(1, -54, 0.5, -10),
		BackgroundColor3 = col(th, "PanelLight"), TextColor3 = col(th, "Text"), TextSize = 14,
	}, function()
		minimized = not minimized
		body.Visible = not minimized
		main.Size = minimized and UDim2.fromOffset(w, 32) or UDim2.fromOffset(w, h)
	end)
	button(top, {
		Text = "x", Size = UDim2.fromOffset(24, 20), Position = UDim2.new(1, -26, 0.5, -10),
		BackgroundColor3 = col(th, "AccentRed"), TextSize = 14,
	}, function()
		gui:Destroy()
		MG._windows[id] = nil
		MG._balListeners[id] = nil
	end)
	local dragging, dragStart, startPos
	top.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local d = input.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	local win = { gui = gui, main = main, body = body, title = title }
	MG._windows[id] = win
	return win
end

-- shared header: balance + bet controls
local function makeBalBet(body, id, startBet)
	local th = detectTheme()
	local bet = startBet or 25
	local balLbl = label(body, {
		Text = "Bal " .. moneyLabel(MG.GetBalance()),
		Size = UDim2.new(0.55, 0, 0, 18),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
	})
	local betLbl = label(body, {
		Text = "Bet " .. moneyLabel(bet),
		Position = UDim2.new(0.55, 0, 0, 0),
		Size = UDim2.new(0.45, 0, 0, 18),
		TextSize = 12,
		TextColor3 = col(th, "SubText"),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	button(body, {
		Text = "Bet -", Size = UDim2.new(0.48, -3, 0, 24), Position = UDim2.new(0, 0, 0, 22),
		BackgroundColor3 = col(th, "PanelLight"), TextColor3 = col(th, "Text"), TextSize = 11,
	}, function()
		bet = math.max(5, bet - 25)
		betLbl.Text = "Bet " .. moneyLabel(bet)
	end)
	button(body, {
		Text = "Bet +", Size = UDim2.new(0.48, -3, 0, 24), Position = UDim2.new(0.52, 0, 0, 22),
		BackgroundColor3 = col(th, "PanelLight"), TextColor3 = col(th, "Text"), TextSize = 11,
	}, function()
		bet = math.min(MG.GetBalance(), bet + 25)
		if bet < 5 then bet = 5 end
		betLbl.Text = "Bet " .. moneyLabel(bet)
	end)
	watchBalance(id, function(b)
		balLbl.Text = "Bal " .. moneyLabel(b)
		if bet > b then
			bet = math.max(5, b)
			betLbl.Text = "Bet " .. moneyLabel(bet)
		end
	end)
	return {
		getBet = function() return bet end,
		setBet = function(v)
			bet = math.max(5, math.floor(v))
			betLbl.Text = "Bet " .. moneyLabel(bet)
		end,
		balLbl = balLbl,
		betLbl = betLbl,
		contentY = 52,
	}
end

