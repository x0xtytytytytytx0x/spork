local function startDayTicker()
	if MG._dayConn then return end
	MG._dayConn = RunService.Heartbeat:Connect(function()
		if not MG._data then return end
		-- days always advance while any R8 minigame UI is open
		if anyMinigameOpen() then
			advanceDaysIfNeeded()
		end
	end)
end
local function startCPSTicker()
	startDayTicker()
	if MG._cpsConn then return end
	MG._cpsConn = RunService.Heartbeat:Connect(function()
		if not MG._data then return end
		if not clickerOpen() then
			MG._data.lastTick = os.clock()
			return
		end
		local now = os.clock()
		local dt = now - (MG._data.lastTick or now)
		if dt < 0 then dt = 0 end
		if dt > 60 then dt = 60 end
		MG._data.lastTick = now
		local cps = computeCPS()
		if cps > 0 and dt > 0 then
			local gain = cps * dt
			MG._data.cookies += gain
			MG._data.cookiesAllTime = (MG._data.cookiesAllTime or 0) + gain
			MG._data.cookiesSession = (MG._data.cookiesSession or 0) + gain
			MG._tickAcc = (MG._tickAcc or 0) + dt
			if MG._tickAcc >= 0.25 then MG._tickAcc = 0; fireBalance() end
			MG._saveAcc = (MG._saveAcc or 0) + dt
			if MG._saveAcc >= 5 then MG._saveAcc = 0; MG.Save() end
		end
	end)
end
local function dayStatusText()
	if not MG._data then return "—" end
	advanceDaysIfNeeded()
	local phase = dayPhase01()
	local leftSec = math.max(0, math.floor((1 - phase) * DAY_SECONDS))
	local dtax = daysUntilTax()
	local cps = 0
	pcall(function() cps = computeCPS() end)
	local taxAmt = math.max(1, math.floor(cps * 10 + 1e-9))
	local taxHint
