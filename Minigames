		local g = tostring(box.Text or ""):lower():gsub("%s", "")
		box.Text = ""
		if #g ~= 5 or not g:match("^%a+$") then msg.Text = "Need 5 letters." return end
		tries += 1
		local row = {}
		local tcount = {}
		for i = 1, 5 do
			local ch = target:sub(i, i)
			tcount[ch] = (tcount[ch] or 0) + 1
		end
		local status = {}
		for i = 1, 5 do
			if g:sub(i, i) == target:sub(i, i) then
				status[i] = "G"
				tcount[g:sub(i, i)] -= 1
			end
		end
		for i = 1, 5 do
			if status[i] then
				table.insert(row, g:sub(i, i):upper())
			else
				local ch = g:sub(i, i)
				if (tcount[ch] or 0) > 0 then
					tcount[ch] -= 1
					table.insert(row, ch)
				else
					table.insert(row, ".")
				end
			end
		end
		-- simple display: uppercase = correct pos, lower = wrong pos, . = miss
		local disp = {}
		for i = 1, 5 do
			if status[i] then disp[i] = g:sub(i, i):upper()
			elseif row[i] ~= "." then disp[i] = g:sub(i, i)
			else disp[i] = "_" end
		end
		table.insert(lines, table.concat(disp, " "))
		hist.Text = table.concat(lines, "\n")
		if g == target then
			payoutWin(bb.getBet())
			msg.Text = "Solved! +" .. moneyLabel(bb.getBet())
			msg.TextColor3 = Color3.fromRGB(120, 255, 140)
			active = false
		elseif tries >= 6 then
			msg.Text = "Out. Word was " .. target
			msg.TextColor3 = col(th, "AccentRed")
			active = false
		else
			msg.Text = tries .. "/6  (UPPER=spot, lower=somewhere)"
		end
	end)
end

