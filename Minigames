local function daysUntilTax()
	if not MG._data then return 5 end
	local d = MG._data.dayNumber or 1
	-- tax on days 5,10,15... → days until next multiple of 5
	local mod = d % 5
	if mod == 0 then return 0 end
	return 5 - mod
end
local function earlyTaxAmount()
