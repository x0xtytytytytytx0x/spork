function MG.OpenTicTacToe()
	if not MG._data then MG.Load() end
	local win = makeWindow("ttt", "Tic Tac Toe", Vector2.new(300, 380))
	local body = win.body
	for _, c in ipairs(body:GetChildren()) do
		c:Destroy()
	end

	local bet = 25
	local board = { "", "", "", "", "", "", "", "", "" }
	local over = false
	local cells = {}

	local balLbl = label(body, {
		Text = "Balance: " .. moneyLabel(MG._data.balance),
		Size = UDim2.new(1, 0, 0, 18),
		Font = Enum.Font.GothamBold,
	})
	local betLbl = label(body, {
		Text = "Bet: " .. moneyLabel(bet) .. " (paid on Deal)",
		Position = UDim2.new(0, 0, 0, 20),
		Size = UDim2.new(1, 0, 0, 16),
		TextSize = 12,
	})
	local msg = label(body, {
		Text = "You are X. Win to double bet.",
		Position = UDim2.new(0, 0, 0, 40),
		Size = UDim2.new(1, 0, 0, 18),
		TextSize = 12,
		TextColor3 = Color3.fromRGB(180, 190, 220),
	})

	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Position = UDim2.new(0.5, -105, 0, 70)
	grid.Size = UDim2.fromOffset(210, 210)
	grid.Parent = body

	local function winner()
		local lines = {
			{ 1, 2, 3 }, { 4, 5, 6 }, { 7, 8, 9 },
			{ 1, 4, 7 }, { 2, 5, 8 }, { 3, 6, 9 },
			{ 1, 5, 9 }, { 3, 5, 7 },
		}
		for _, ln in ipairs(lines) do
			local a, b, c = board[ln[1]], board[ln[2]], board[ln[3]]
			if a ~= "" and a == b and b == c then
				return a
			end
		end
		for i = 1, 9 do
			if board[i] == "" then return nil end
		end
		return "draw"
	end

	local function aiMove()
		-- win / block / center / random
		local function try(mark)
			for i = 1, 9 do
				if board[i] == "" then
					board[i] = mark
					local w = winner()
					board[i] = ""
					if w == mark then return i end
				end
			end
			return nil
		end
		local m = try("O") or try("X")
		if not m and board[5] == "" then m = 5 end
		if not m then
			local opts = {}
			for i = 1, 9 do
				if board[i] == "" then table.insert(opts, i) end
			end
			if #opts > 0 then m = opts[math.random(1, #opts)] end
		end
		if m then
			board[m] = "O"
			if cells[m] then cells[m].Text = "O" end
		end
	end

	local function finish(result)
		over = true
		if result == "X" then
			addCash(bet * 2)
			MG._data.stats.tttWins = (MG._data.stats.tttWins or 0) + 1
			msg.Text = "You win +" .. moneyLabel(bet) .. "!"
			msg.TextColor3 = Color3.fromRGB(120, 255, 140)
		elseif result == "O" then
			MG._data.stats.tttLosses = (MG._data.stats.tttLosses or 0) + 1
			MG.Save()
			msg.Text = "AI wins."
			msg.TextColor3 = Color3.fromRGB(255, 120, 120)
		else
			addCash(bet)
			MG._data.stats.tttDraws = (MG._data.stats.tttDraws or 0) + 1
			MG.Save()
			msg.Text = "Draw — bet returned."
			msg.TextColor3 = Color3.fromRGB(200, 200, 120)
		end
		balLbl.Text = "Balance: " .. moneyLabel(MG._data.balance)
	end

	local function onCell(i)
		if over or board[i] ~= "" then return end
		board[i] = "X"
		cells[i].Text = "X"
		local w = winner()
		if w then
			finish(w)
			return
		end
		aiMove()
		w = winner()
		if w then
			finish(w)
		end
	end

	for i = 1, 9 do
		local r = math.floor((i - 1) / 3)
		local c = (i - 1) % 3
		local cell = button(grid, {
			Text = "",
			Size = UDim2.fromOffset(64, 64),
			Position = UDim2.fromOffset(c * 72, r * 72),
			BackgroundColor3 = Color3.fromRGB(40, 46, 62),
			TextSize = 28,
		}, function()
			onCell(i)
		end)
		cells[i] = cell
	end

	local function newGame()
		if not trySpend(bet) then
			msg.Text = "Not enough cash."
			msg.TextColor3 = Color3.fromRGB(255, 120, 120)
			return
		end
		board = { "", "", "", "", "", "", "", "", "" }
		over = false
		for i = 1, 9 do
			cells[i].Text = ""
		end
		msg.Text = "Your move (X)."
		msg.TextColor3 = Color3.fromRGB(180, 190, 220)
		balLbl.Text = "Balance: " .. moneyLabel(MG._data.balance)
	end

	button(body, {
		Text = "New game (bet " .. moneyLabel(bet) .. ")",
		Size = UDim2.new(1, 0, 0, 32),
		Position = UDim2.new(0, 0, 1, -36),
		BackgroundColor3 = Color3.fromRGB(90, 116, 253),
	}, newGame)

	button(body, {
		Text = "Bet +25",
		Size = UDim2.fromOffset(80, 24),
		Position = UDim2.new(1, -80, 0, 18),
		BackgroundColor3 = Color3.fromRGB(70, 75, 95),
		TextSize = 11,
	}, function()
		if not over and board[1] == "" and board[5] == "" then
			-- only before first move of unpaid round is messy; just adjust next bet
		end
		bet = math.min(MG._data.balance, bet + 25)
		betLbl.Text = "Bet: " .. moneyLabel(bet) .. " (on New game)"
	end)
end

