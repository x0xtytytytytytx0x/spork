	local bb = makeBalBet(body, "ttt", 25)
	local board, over, cells = { "", "", "", "", "", "", "", "", "" }, false, {}
	local msg = label(body, { Text = "Buy-in then play. Win = 2x.", Position = UDim2.new(0, 0, 0, bb.contentY), Size = UDim2.new(1, 0, 0, 16), TextSize = 11, TextColor3 = col(th, "SubText") })
	local grid = Instance.new("Frame"); grid.BackgroundTransparency = 1; grid.Position = UDim2.new(0.5, -90, 0, bb.contentY + 22); grid.Size = UDim2.fromOffset(180, 180); grid.Parent = body
	local function winner()
		local lines = { {1,2,3},{4,5,6},{7,8,9},{1,4,7},{2,5,8},{3,6,9},{1,5,9},{3,5,7} }
		for _, ln in ipairs(lines) do
			local a, b, c = board[ln[1]], board[ln[2]], board[ln[3]]
			if a ~= "" and a == b and b == c then return a end
		end
		for i = 1, 9 do if board[i] == "" then return nil end end
		return "draw"
	end
	local function aiMove()
		local function try(mark)
			for i = 1, 9 do if board[i] == "" then board[i] = mark; local w = winner(); board[i] = ""; if w == mark then return i end end end
		end
		local m = try("O") or try("X")
		if not m and board[5] == "" then m = 5 end
		if not m then local opts = {} for i = 1, 9 do if board[i] == "" then table.insert(opts, i) end end if #opts > 0 then m = opts[math.random(1, #opts)] end end
		if m then board[m] = "O"; if cells[m] then cells[m].Text = "O" end end
	end
	local function finish(result)
		over = true; local bet = bb.getBet()
		if result == "X" then payoutWin(bet); msg.Text = "Win +" .. moneyLabel(bet) .. "  (2×)"; msg.TextColor3 = Color3.fromRGB(120, 255, 140)
		elseif result == "O" then payoutLose(bet); msg.Text = "Lose"; msg.TextColor3 = col(th, "AccentRed")
		else payoutPush(bet); msg.Text = "Draw"; msg.TextColor3 = Color3.fromRGB(220, 210, 120) end
	end
	for i = 1, 9 do
		local r, c = math.floor((i - 1) / 3), (i - 1) % 3
		cells[i] = button(grid, { Text = "", Size = UDim2.fromOffset(54, 54), Position = UDim2.fromOffset(c * 62, r * 62), BackgroundColor3 = col(th, "Panel"), TextSize = 22, TextColor3 = col(th, "Text") }, function()
			if over or board[i] ~= "" then return end
			board[i] = "X"; cells[i].Text = "X"
			local w = winner(); if w then finish(w); return end
			aiMove(); w = winner(); if w then finish(w) end
		end)
	end
	button(body, { Text = "New game (pay bet)", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 1, -28), BackgroundColor3 = col(th, "AccentBlue") }, function()
		if not trySpend(bb.getBet()) then msg.Text = "Need cookies."; msg.TextColor3 = col(th, "AccentRed"); return end
		board = { "", "", "", "", "", "", "", "", "" }; over = false
		for i = 1, 9 do cells[i].Text = "" end
		msg.Text = "Your move."; msg.TextColor3 = col(th, "SubText")
	end)
end
function MG.OpenRPS()
	if not MG._data then MG.Load() end
	local th = detectTheme()
	local win = makeWindow("rps", "Rock Paper Scissors", Vector2.new(280, 220))
	local body = win.body
	for _, c in ipairs(body:GetChildren()) do c:Destroy() end
	local bb = makeBalBet(body, "rps", 25)
	local msg = label(body, { Text = "Pick one. Win = 2x.", Position = UDim2.new(0, 0, 0, bb.contentY), Size = UDim2.new(1, 0, 0, 36), TextWrapped = true, TextSize = 12, TextColor3 = col(th, "SubText") })
	local opts = { "Rock", "Paper", "Scissors" }
	local function play(choice)
		local bet = bb.getBet()
		if not trySpend(bet) then msg.Text = "Need cookies."; msg.TextColor3 = col(th, "AccentRed"); return end
		local ai = opts[math.random(1, 3)]
		local winMap = { Rock = "Scissors", Paper = "Rock", Scissors = "Paper" }
		if choice == ai then payoutPush(bet); msg.Text = "Tie vs " .. ai; msg.TextColor3 = Color3.fromRGB(220, 210, 120)
		elseif winMap[choice] == ai then payoutWin(bet); msg.Text = choice .. " beats " .. ai .. "  +" .. moneyLabel(bet); msg.TextColor3 = Color3.fromRGB(120, 255, 140)
		else payoutLose(bet); msg.Text = ai .. " beats " .. choice; msg.TextColor3 = col(th, "AccentRed") end
	end
	for i, name in ipairs(opts) do
		button(body, { Text = name, Size = UDim2.new(0.32, -2, 0, 32), Position = UDim2.new((i - 1) * 0.34, 0, 0, bb.contentY + 50), BackgroundColor3 = col(th, "AccentBlue") }, function() play(name) end)
	end
end
