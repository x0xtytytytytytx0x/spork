local function makeBalBet(body, id, startBet)
	local th = detectTheme()
	local bet = math.max(1, math.floor(tonumber(startBet) or 25))
	local balLbl = label(body, { Text = "Cash " .. moneyLabel(MG.GetBalance()), Size = UDim2.new(1, 0, 0, 16), Font = Enum.Font.GothamBold, TextSize = 12 })
	local box
	local function setBet(n)
		n = math.floor(tonumber(n) or 1)
		if n < 1 then n = 1 end
		local bal = math.floor(MG.GetBalance())
		if bal < 1 then bet = 1; if box then box.Text = "1" end; return end
		if n > bal then n = bal end
		bet = n
		if box then box.Text = tostring(bet) end
	end
	button(body, {
		Text = "Bet -", Size = UDim2.new(0.22, -2, 0, 24), Position = UDim2.new(0, 0, 0, 20),
		BackgroundColor3 = col(th, "PanelLight"), TextColor3 = col(th, "Text"), TextSize = 11,
	}, function()
		setBet(bet - math.max(1, math.floor(bet * 0.25)))
	end)
	box = Instance.new("TextBox")
	box.Size = UDim2.new(0.34, -4, 0, 24); box.Position = UDim2.new(0.22, 2, 0, 20)
	box.BackgroundColor3 = col(th, "Panel"); box.TextColor3 = col(th, "Text")
	box.PlaceholderText = "bet"; box.PlaceholderColor3 = col(th, "SubText")
	box.Font = Enum.Font.GothamBold; box.TextSize = 12; box.Text = tostring(bet)
	box.ClearTextOnFocus = false; box.BorderSizePixel = 0; box.Parent = body; corner(box, 6)
	button(body, {
		Text = "Bet +", Size = UDim2.new(0.22, -2, 0, 24), Position = UDim2.new(0.56, 2, 0, 20),
		BackgroundColor3 = col(th, "PanelLight"), TextColor3 = col(th, "Text"), TextSize = 11,
	}, function()
		setBet(bet + math.max(1, math.floor(math.max(bet, 10) * 0.25)))
	end)
	button(body, {
		Text = "MAX", Size = UDim2.new(0.22, -2, 0, 24), Position = UDim2.new(0.78, 2, 0, 20),
		BackgroundColor3 = col(th, "AccentBlue"), TextColor3 = Color3.new(1, 1, 1), TextSize = 11,
	}, function()
		setBet(math.floor(MG.GetBalance()))
	end)
	box.FocusLost:Connect(function()
		setBet(tonumber(box.Text) or bet)
	end)
	watchBalance(id, function(b)
		balLbl.Text = "Cash " .. moneyLabel(b)
		if bet > b then setBet(b) end
	end)
	return {
		getBet = function()
			local n = tonumber(box and box.Text)
			if n then setBet(n) end
			return bet
		end,
		contentY = 50,
	}
end
