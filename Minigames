
--[[
	R8 Minigames (remote module)
	Upload to: https://raw.githubusercontent.com/x0xtytytytytytx0x/spork/refs/heads/main/Minigames

	API:
	  local MG = loadstring(game:HttpGet(url))()
	  MG.OpenHub()           -- launcher with balance + open games
	  MG.OpenBank()
	  MG.OpenBlackjack()
	  MG.OpenTicTacToe()
	  MG.GetBalance()
	  MG.Save() / MG.Load()

	Saves: R8TW0/minigames.json (Potassium / executor FS)
	Windows: draggable, minimize, close — DisplayOrder always on top
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local SAVE_PATH = "R8TW0/minigames.json"
local STARTING_CASH = 1000
local DISPLAY_ORDER = 2147483646 -- above core / esc menus when possible

local MG = {
	Version = "1.0",
	_windows = {},
	_data = nil,
}

------------------------------------------------------------
-- Persistence
------------------------------------------------------------
local function fsOk()
	return typeof(writefile) == "function" and typeof(readfile) == "function"
end

local function ensureRoot()
	if not fsOk() then return end
	pcall(function()
		if typeof(makefolder) == "function" then
			if typeof(isfolder) ~= "function" or not isfolder("R8TW0") then
				makefolder("R8TW0")
			end
		end
	end)
end

local function defaultData()
	return {
		balance = STARTING_CASH,
		loanPrincipal = 0,
		loanOwed = 0,
		loanRate = 0.15, -- 15% interest per take / compound on late
		loanStrikes = 0,
		stats = {
			bjWins = 0,
			bjLosses = 0,
			tttWins = 0,
			tttLosses = 0,
			tttDraws = 0,
		},
		lastSave = os.time(),
	}
end

function MG.Load()
	local d = defaultData()
	if fsOk() then
		pcall(function()
			if typeof(isfile) == "function" and not isfile(SAVE_PATH) then return end
			local raw = readfile(SAVE_PATH)
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if ok and type(decoded) == "table" then
				for k, v in pairs(decoded) do
					if k == "stats" and type(v) == "table" then
						for sk, sv in pairs(v) do
							d.stats[sk] = sv
						end
					else
						d[k] = v
					end
				end
			end
		end)
	end
	d.balance = math.max(0, math.floor(tonumber(d.balance) or STARTING_CASH))
	d.loanOwed = math.max(0, tonumber(d.loanOwed) or 0)
	d.loanPrincipal = math.max(0, tonumber(d.loanPrincipal) or 0)
	MG._data = d
	return d
end

function MG.Save()
	if not MG._data then MG.Load() end
	MG._data.lastSave = os.time()
	if not fsOk() then return false end
	ensureRoot()
	local ok = pcall(function()
		writefile(SAVE_PATH, HttpService:JSONEncode(MG._data))
	end)
	return ok == true
end

function MG.GetBalance()
	if not MG._data then MG.Load() end
	return MG._data.balance
end

local function addCash(n)
	if not MG._data then MG.Load() end
	MG._data.balance = math.max(0, math.floor(MG._data.balance + (tonumber(n) or 0)))
	MG.Save()
	return MG._data.balance
end

local function trySpend(n)
	n = math.floor(tonumber(n) or 0)
	if n <= 0 then return false end
	if not MG._data then MG.Load() end
	if MG._data.balance < n then return false end
	MG._data.balance -= n
	MG.Save()
	return true
end

------------------------------------------------------------
-- UI helpers (floating windows)
------------------------------------------------------------
local function corner(p, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = p
	return c
end

local function stroke(p, color, t)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(80, 90, 120)
	s.Thickness = t or 1
	s.Parent = p
	return s
end

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamMedium
	l.TextSize = 14
	l.TextColor3 = Color3.fromRGB(230, 235, 255)
	l.TextXAlignment = Enum.TextXAlignment.Left
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function button(parent, props, cb)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = true
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.TextColor3 = Color3.new(1, 1, 1)
	b.BackgroundColor3 = Color3.fromRGB(90, 116, 253)
	b.BorderSizePixel = 0
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	corner(b, 6)
	b.Parent = parent
	if cb then
		b.MouseButton1Click:Connect(cb)
	end
	return b
end

local function getHost()
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui")
	local host = pg:FindFirstChild("R8_MinigamesHost")
	if not host then
		host = Instance.new("ScreenGui")
		host.Name = "R8_MinigamesHost"
		host.ResetOnSpawn = false
		host.IgnoreGuiInset = true
		host.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		host.DisplayOrder = DISPLAY_ORDER
		host.Parent = pg
	else
		host.DisplayOrder = DISPLAY_ORDER
	end
	return host
end

local function makeWindow(id, titleText, size)
	if MG._windows[id] and MG._windows[id].gui and MG._windows[id].gui.Parent then
		MG._windows[id].gui.Enabled = true
		return MG._windows[id]
	end

	local host = getHost()
	local gui = Instance.new("ScreenGui")
	gui.Name = "R8MG_" .. id
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = DISPLAY_ORDER
	gui.Parent = host.Parent -- sibling under PlayerGui so DisplayOrder competes at top level

	local w, h = size.X, size.Y
	local main = Instance.new("Frame")
	main.Name = "Main"
	main.Size = UDim2.fromOffset(w, h)
	main.Position = UDim2.new(0.5, -w / 2, 0.5, -h / 2)
	main.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
	main.BorderSizePixel = 0
	main.Active = true
	main.Parent = gui
	corner(main, 10)
	stroke(main, Color3.fromRGB(90, 116, 253), 1.5)

	local top = Instance.new("Frame")
	top.Name = "TopBar"
	top.Size = UDim2.new(1, 0, 0, 32)
	top.BackgroundColor3 = Color3.fromRGB(28, 32, 44)
	top.BorderSizePixel = 0
	top.Parent = main
	corner(top, 10)

	-- cover bottom corners of top bar
	local topCover = Instance.new("Frame")
	topCover.BackgroundColor3 = top.BackgroundColor3
	topCover.BorderSizePixel = 0
	topCover.Position = UDim2.new(0, 0, 1, -10)
	topCover.Size = UDim2.new(1, 0, 0, 10)
	topCover.Parent = top

	local title = label(top, {
		Text = titleText,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -90, 1, 0),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
	})

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.new(0, 10, 0, 40)
	body.Size = UDim2.new(1, -20, 1, -50)
	body.Parent = main

	local minimized = false
	local minBtn = button(top, {
		Text = "–",
		Size = UDim2.fromOffset(26, 22),
		Position = UDim2.new(1, -60, 0.5, -11),
		BackgroundColor3 = Color3.fromRGB(60, 70, 100),
	}, function()
		minimized = not minimized
		body.Visible = not minimized
		main.Size = minimized and UDim2.fromOffset(w, 32) or UDim2.fromOffset(w, h)
	end)

	local closeBtn = button(top, {
		Text = "×",
		Size = UDim2.fromOffset(26, 22),
		Position = UDim2.new(1, -30, 0.5, -11),
		BackgroundColor3 = Color3.fromRGB(200, 60, 70),
		TextSize = 16,
	}, function()
		gui:Destroy()
		MG._windows[id] = nil
	end)

	-- drag
	local dragging, dragStart, startPos
	top.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	local win = {
		gui = gui,
		main = main,
		body = body,
		title = title,
		setTitle = function(_, t)
			title.Text = t
		end,
	}
	MG._windows[id] = win
	return win
end

local function moneyLabel(n)
	return "$" .. tostring(math.floor(tonumber(n) or 0))
end

