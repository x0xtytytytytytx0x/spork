function MG.OpenTicTacToe()
	if not MG._data then MG.Load() end
	local th = detectTheme()
	local win = makeWindow("ttt", "Tic Tac Toe", Vector2.new(280, 340))
	local body = win.body
	for _, c in ipairs(body:GetChildren()) do c:Destroy() end
	local bb = makeBalBet(body, "ttt", 25)
	local board, over, cells = { "", "", "", "", "", "", "", "", "" }, false, {}
	local msg = label(body, { Text = "X to play. Win = 2x bet.", Position = UDim2.new(0, 0, 0, bb.contentY), Size = UDim2.new(1, 0, 0, 16), TextSize = 11, TextColor3 = col(th, "SubText") })
	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Position = UDim2.new(0.5, -90, 0, bb.contentY + 22)
	grid.Size = UDim2.fromOffset(180, 180)
	grid.Parent = body
	local function winner()
		local lines = { {1,2,3},{4,5,6},{7,8,9},{1,4,7},{2,5,8},{3,6,9},{1,5,9},{3,5,7} }
		for _, ln in ipairs(lines) do
			local a, b, c = board[ln[1]], board[ln[2]], board[ln[3]]
			if a ~= "" and a == b and b == c then return a end
		end
		for i = 1, 9 do if board[i] == "" then return nil end end
		return "draw"
	end
	local function aiMove()
		local function try(mark)
			for i = 1, 9 do
				if board[i] == "" then board[i] = mark local w = winner() board[i] = "" if w == mark then return i end end
			end
		end
		local m = try("O") or try("X")
		if not m and board[5] == "" then m = 5 end
		if not m then
			local opts = {}
			for i = 1, 9 do if board[i] == "" then table.insert(opts, i) end end
			if #opts > 0 then m = opts[math.random(1, #opts)] end
		end
		if m then board[m] = "O" if cells[m] then cells[m].Text = "O" end end
	end
	local function finish(result)
		over = true
		local bet = bb.getBet()
		if result == "X" then payoutWin(bet) msg.Text = "Win +" .. moneyLabel(bet) msg.TextColor3 = Color3.fromRGB(120, 255, 140)
		elseif result == "O" then msg.Text = "Lose" msg.TextColor3 = col(th, "AccentRed")
		else payoutPush(bet) msg.Text = "Draw" msg.TextColor3 = Color3.fromRGB(220, 210, 120) end
	end
	for i = 1, 9 do
		local r, c = math.floor((i - 1) / 3), (i - 1) % 3
		cells[i] = button(grid, {
