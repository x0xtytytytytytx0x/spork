local function dayPhase01()
	-- 0..1 within current day
	if not MG._data then return 0 end
	local start = MG._data.dayStartUnix or os.time()
	local elapsed = os.time() - start
	if elapsed < 0 then elapsed = 0 end
	return (elapsed % DAY_SECONDS) / DAY_SECONDS
end
