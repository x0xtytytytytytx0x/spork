local function totalLoanOwed()
	local t = 0
	if not MG._data then return 0 end
	for _, ln in ipairs(MG._data.loans or {}) do t += (ln.owed or 0) end
	return t
end
local function advanceDaysIfNeeded()
	if not MG._data then return end
	local start = MG._data.dayStartUnix or os.time()
	local elapsed = os.time() - start
	if elapsed < DAY_SECONDS then return false end
	local daysPassed = math.floor(elapsed / DAY_SECONDS)
	if daysPassed < 1 then return false end
	local prevDay = MG._data.dayNumber or 1
	MG._data.dayNumber = prevDay + daysPassed
	MG._data.dayStartUnix = start + daysPassed * DAY_SECONDS
	-- mild late growth on loans (optional debt; not forced except tax day)
	for _, loan in ipairs(MG._data.loans or {}) do
		for _ = 1, daysPassed do
			loan.owed = math.floor((loan.owed or 0) * 1.03)
		end
		loan.lastFeeDay = MG._data.dayNumber
	end
	-- tax every 5 days
	local cycle = math.floor((MG._data.dayNumber - 1) / 5)
	local paidCycle = math.floor((MG._data.taxDayPaid or 0) / 5)
	if cycle > paidCycle then
		if (MG._data.pendingTax or 0) > 0 then
			MG._data._taxWipe = true
		else
			local cps = 0
			pcall(function() cps = computeCPS() end)
			local tax = math.max(1, math.floor(cps * 10))
			-- on tax day also collect loans from cash or wipe
			local loans = totalLoanOwed()
			MG._data.pendingTax = tax
			MG._data._taxLoans = loans
			-- auto-seize loans + tax from account
			local need = tax + loans
			if (MG._data.cookies or 0) >= need then
				MG._data.cookies -= need
				MG._data.loans = {}
				MG._data.pendingTax = 0
				MG._data.taxDayPaid = MG._data.dayNumber
				MG._data._taxSeized = need
			else
				-- not enough → lose
				MG._data._taxWipe = true
			end
		end
	end
	MG.Save()
	fireBalance()
	return true
end
function MG.Load()
	local d = defaultData()
	if fsOk() then
		pcall(function()
			if typeof(isfile) == "function" and not isfile(SAVE_PATH) then return end
			local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(SAVE_PATH)) end)
			if ok and type(decoded) == "table" then
				if decoded.balance and not decoded.cookies then decoded.cookies = decoded.balance; decoded.cookiesAllTime = decoded.balance end
				for k, v in pairs(decoded) do
					if k == "buildings" and type(v) == "table" then
						for id, n in pairs(v) do d.buildings[id] = tonumber(n) or 0 end
					elseif k == "upgrades" and type(v) == "table" then d.upgrades = v
					elseif k == "stats" and type(v) == "table" then d.stats = v
					else d[k] = v end
				end
			end
		end)
	end
	d.cookies = math.max(0, tonumber(d.cookies) or 0)
	d.cookiesAllTime = math.max(d.cookies, tonumber(d.cookiesAllTime) or 0)
	d.prestige = math.max(0, math.floor(tonumber(d.prestige) or 0))
	d.prestigeMult = math.max(1, tonumber(d.prestigeMult) or (1 + d.prestige * 0.5))
	for _, b in ipairs(BUILDINGS) do d.buildings[b.id] = math.max(0, math.floor(tonumber(d.buildings[b.id]) or 0)) end
	d.upgrades = d.upgrades or {}
	d.loans = type(d.loans) == "table" and d.loans or {}
	-- migrate legacy single-loan
	if (#d.loans == 0) and (tonumber(d.loanOwed) or 0) > 0 then
		table.insert(d.loans, {
			id = 1, amount = tonumber(d.loanPrincipal) or d.loanOwed,
			owed = tonumber(d.loanOwed) or 0,
			startDay = d.dayNumber or 1, lastFeeDay = d.dayNumber or 1,
		})
	end
	d.dayNumber = math.max(1, math.floor(tonumber(d.dayNumber) or 1))
	d.dayStartUnix = tonumber(d.dayStartUnix) or tonumber(d.dayEpoch) or os.time()
	if d.dayStartUnix < 100000 then d.dayStartUnix = os.time() end -- migrate clock→unix
	d.taxDayPaid = math.floor(tonumber(d.taxDayPaid) or 0)
	d.pendingTax = math.max(0, math.floor(tonumber(d.pendingTax) or 0))
	d.history = type(d.history) == "table" and d.history or {}
	d.lastTick = os.clock()
	MG._data = d
	return d
end
