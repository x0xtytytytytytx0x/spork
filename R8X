-- Muffle (simplified track)
local trackedSounds, muffleConnections = {}, {}
local muffleLoopRunning = false
local function getSoundWorldPosition(sound)
	local p = sound.Parent
	if not p then return nil end
	if p:IsA("Attachment") then return p.WorldPosition end
	if p:IsA("BasePart") then return p.Position end
	return nil
end
local function cleanupTrackedSound(sound)
	local eq = trackedSounds[sound]
	if eq then pcall(function() eq:Destroy() end) trackedSounds[sound] = nil end
end
local function startTrackingSound(sound)
	if not R8_RTX.DistanceMuffleEnabled or trackedSounds[sound] then return end
	if not getSoundWorldPosition(sound) then return end
	local n = 0 for _ in pairs(trackedSounds) do n += 1 end
	if n >= R8_RTX.MaxTrackedSounds then return end
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Name = TAG.MUFFLE
	eq.Parent = sound
	trackedSounds[sound] = eq
end
local function stopWatchingSound(sound)
	local conns = muffleConnections[sound]
	if conns then for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end muffleConnections[sound] = nil end
	cleanupTrackedSound(sound)
end
local function watchSoundLifecycle(sound)
	if muffleConnections[sound] then return end
	muffleConnections[sound] = {
		sound.Played:Connect(function() startTrackingSound(sound) end),
		sound.Ended:Connect(function() cleanupTrackedSound(sound) end),
		sound.AncestryChanged:Connect(function(_, parent) if not parent then stopWatchingSound(sound) end end),
	}
	if sound.IsPlaying then startTrackingSound(sound) end
end
local function muffleUpdateLoop()
	if muffleLoopRunning then return end
	muffleLoopRunning = true
	while R8_RTX.Applied do
		if R8_RTX.DistanceMuffleEnabled then
			local cam = Workspace.CurrentCamera
			local listenerPos = cam and cam.CFrame.Position
			if listenerPos then
				for sound, eq in pairs(trackedSounds) do
					if sound.Parent and sound.IsPlaying then
						local pos = getSoundWorldPosition(sound)
						if pos then
							local d = (pos - listenerPos).Magnitude
							local a = 0
							if R8_RTX.MuffleMaxDistance > R8_RTX.MuffleMinDistance then
								a = math.clamp((d - R8_RTX.MuffleMinDistance) / (R8_RTX.MuffleMaxDistance - R8_RTX.MuffleMinDistance), 0, 1)
							end
							eq.HighGain = lerp(0, R8_RTX.MuffleMaxHighCut, a)
							eq.MidGain = lerp(0, R8_RTX.MuffleMaxHighCut * 0.4, a)
							eq.LowGain = lerp(0, R8_RTX.MuffleLowBoost, a)
						end
					else
						cleanupTrackedSound(sound)
					end
				end
			end
		end
		task.wait(R8_RTX.MuffleUpdateInterval)
	end
	muffleLoopRunning = false
end
local function revertMuffling()
	for s in pairs(muffleConnections) do stopWatchingSound(s) end
	table.clear(muffleConnections)
	table.clear(trackedSounds)
end

-- Decals
local transparencyConnections, watchedParts = {}, {}
local decalInstanceCount = 0
local DECAL_GRID_SIZE = 50
local decalGrid = {}
local function decalCellKey(pos)
	return math.floor(pos.X / DECAL_GRID_SIZE) .. ":" .. math.floor(pos.Y / DECAL_GRID_SIZE) .. ":" .. math.floor(pos.Z / DECAL_GRID_SIZE)
end
local function addToDecalGrid(part)
	local key = decalCellKey(part.Position)
	decalGrid[key] = decalGrid[key] or {}
	table.insert(decalGrid[key], part)
end
local function buildDecalGrid(targets)
	table.clear(decalGrid)
	for _, part in ipairs(targets) do addToDecalGrid(part) end
end
local function getPlayerOrigin()
	local char = LocalPlayer and LocalPlayer.Character
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
	if root then
		local ok, vel = pcall(function() return root.AssemblyLinearVelocity end)
		return root.Position, (ok and vel and vel.Magnitude) or 0
	end
	local cam = Workspace.CurrentCamera
	if cam then return cam.CFrame.Position, 0 end
	return nil, 0
end
local function partHasOurDecals(part)
	for _, c in ipairs(part:GetChildren()) do
		if c:IsA("Decal") and c.Name:match("^" .. TAG.DECAL) then return true end
	end
	return false
end
local function canReceiveDecals(part, origin)
	if not part:IsA("BasePart") or part:IsA("Terrain") then return false end
	if part.Transparency > 0 then return false end
	local min = R8_RTX.DecalPartMinSize
	local s = part.Size
	if not (s.X >= min or s.Y >= min or s.Z >= min) then return false end
	if origin and (part.Position - origin).Magnitude > R8_RTX.DecalRadius then return false end
	if Players:GetPlayerFromCharacter(part.Parent) then return false end
	if part:FindFirstAncestorOfClass("Tool") then return false end
	return true
end
local function removePartTextures(part)
	for _, c in ipairs(part:GetChildren()) do
		if c:IsA("Decal") and c.Name:match("^" .. TAG.DECAL) then c:Destroy() end
	end
end
local function updateTransparency(part)
	if not part.Parent then return end
	if part.Transparency >= 1 then
		removePartTextures(part)
		part.LocalTransparencyModifier = -1
		return
	end
	part.LocalTransparencyModifier = part.Transparency > 0 and -part.Transparency or 0
end
local function watchTransparency(part)
	if watchedParts[part] then return end
	watchedParts[part] = true
	updateTransparency(part)
	transparencyConnections[part] = part:GetPropertyChangedSignal("Transparency"):Connect(function()
		updateTransparency(part)
	end)
end
local function stampPart(part, origin)
	if decalInstanceCount >= R8_RTX.MaxDecalInstances then return end
	if not canReceiveDecals(part, origin) or partHasOurDecals(part) then return end
	for _, entry in ipairs(DECAL_FACES) do
		if decalInstanceCount >= R8_RTX.MaxDecalInstances then break end
		local d = Instance.new("Decal")
		d.Name = TAG.DECAL .. entry.Face.Name
		d.Texture = entry.Texture
		d.Transparency = DECAL_TRANSPARENCY
		d.Face = entry.Face
		d.Parent = part
		decalInstanceCount += 1
	end
	watchTransparency(part)
end
local function removeDecalsAndUnwatch(part)
	local removed = 0
	for _, c in ipairs(part:GetChildren()) do
		if c:IsA("Decal") and c.Name:match("^" .. TAG.DECAL) then c:Destroy() removed += 1 end
	end
	decalInstanceCount = math.max(0, decalInstanceCount - removed)
	local conn = transparencyConnections[part]
	if conn then pcall(function() conn:Disconnect() end) transparencyConnections[part] = nil end
	watchedParts[part] = nil
	if part.Parent then part.LocalTransparencyModifier = 0 end
end

local decalQueue, decalQueueIndex, decalQueueRunning = {}, 1, false
local function processDecalQueue()
	if decalQueueRunning then return end
	decalQueueRunning = true
	local processed, origin = 0, getPlayerOrigin()
	while decalQueueIndex <= #decalQueue do
		if processed == 0 then origin = getPlayerOrigin() end
		local part = decalQueue[decalQueueIndex]
		decalQueueIndex += 1
		if part and part.Parent then stampPart(part, origin) end
		processed += 1
		if processed >= R8_RTX.DecalBatchSize then processed = 0 RunService.Heartbeat:Wait() end
	end
	table.clear(decalQueue)
	decalQueueIndex = 1
	decalQueueRunning = false
end
local function enqueueDecalTarget(part) table.insert(decalQueue, part) end

local decalRangeLoopRunning = false
local function decalRangeCheckLoop()
	if decalRangeLoopRunning then return end
	decalRangeLoopRunning = true
	while R8_RTX.Applied and R8_RTX.DecalsEnabled do
		local origin, speed = getPlayerOrigin()
		if origin then
			local buffer = R8_RTX.DecalRemoveBufferBase + speed * R8_RTX.DecalRangeCheckInterval * 1.5
			local removeRadius = R8_RTX.DecalRadius + buffer
			local cellRadius = math.ceil(removeRadius / DECAL_GRID_SIZE)
			local key = decalCellKey(origin)
			local ox = tonumber(key:match("^(%-?%d+)")) or 0
			local oy = tonumber(key:match("^%-?%d+:(%-?%d+)")) or 0
			local oz = tonumber(key:match(":(%-?%d+)$")) or 0
			local toStamp, seen = {}, {}
			for x = ox - cellRadius, ox + cellRadius do
				for y = oy - cellRadius, oy + cellRadius do
					for z = oz - cellRadius, oz + cellRadius do
						local bucket = decalGrid[x .. ":" .. y .. ":" .. z]
						if bucket then
							for _, part in ipairs(bucket) do
								if part.Parent and not seen[part] and not partHasOurDecals(part) then
									seen[part] = true
									if (part.Position - origin).Magnitude <= R8_RTX.DecalRadius then
										table.insert(toStamp, part)
									end
								end
							end
						end
					end
				end
			end
			if #toStamp > 0 then
				for _, part in ipairs(toStamp) do enqueueDecalTarget(part) end
				processDecalQueue()
			end
			for part in pairs(watchedParts) do
				if part.Parent then
					if (part.Position - origin).Magnitude > removeRadius then
						removeDecalsAndUnwatch(part)
					end
				else
					watchedParts[part] = nil
				end
			end
		end
		task.wait(R8_RTX.DecalRangeCheckInterval)
	end
	decalRangeLoopRunning = false
end

local function clearDecals()
	local removed = 0
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("Decal") and inst.Name:match("^" .. TAG.DECAL) then
			inst:Destroy()
			removed += 1
			if removed % 40 == 0 then RunService.Heartbeat:Wait() end
		end
	end
	decalInstanceCount = 0
end

