local function clearOwnedLighting()
	for _, c in ipairs(Lighting:GetChildren()) do
		if c.Name:match("^" .. TAG.FX) then c:Destroy() end
	end
end

local function addFX(className, props)
	local e = Instance.new(className)
	e.Name = TAG.FX .. className
	for k, v in pairs(props) do pcall(function() e[k] = v end) end
	e.Parent = Lighting
	return e
end

local function applyPostFX(preset)
	clearOwnedLighting()
	addFX("Atmosphere", {
		Density = 0.32, Glare = 1, Haze = preset.AtmosphereHaze or 0.12,
		Color = preset.AtmosphereColor or Color3.fromRGB(255, 255, 255),
		Decay = Color3.fromRGB(0, 0, 0), Offset = 0,
	})
	if R8_RTX.BloomEnabled then
		addFX("BloomEffect", { Enabled = true, Intensity = preset.BloomIntensity or 1, Size = 50, Threshold = 1 })
	end
	addFX("BlurEffect", { Enabled = true, Size = 1 })
	addFX("ColorCorrectionEffect", {
		Enabled = true, Brightness = 0.02, Contrast = 0.3, Saturation = -0.15,
		TintColor = Color3.fromRGB(255, 255, 255),
	})
	addFX("DepthOfFieldEffect", {
		Enabled = true, FarIntensity = 0.75, FocusDistance = 0.05, InFocusRadius = 200, NearIntensity = 0.75,
	})
	addFX("SunRaysEffect", { Enabled = true, Intensity = preset.SunRaysIntensity or 0.2, Spread = 0.5 })
end

local function ensureFutureLighting()
	pcall(function() Lighting.Technology = Enum.Technology.Future end)
	if typeof(sethiddenproperty) == "function" then
		pcall(sethiddenproperty, Lighting, "Technology", Enum.Technology.Future)
	end
end

local function applyLightingPreset(name)
	local preset = PRESETS[name] or PRESETS.noon
	ensureFutureLighting()
	Lighting.Brightness = preset.Brightness
	Lighting.Ambient = preset.Ambient
	Lighting.OutdoorAmbient = preset.OutdoorAmbient
	Lighting.ColorShift_Top = preset.ColorShift_Top
	Lighting.ColorShift_Bottom = preset.ColorShift_Bottom
	Lighting.EnvironmentDiffuseScale = preset.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = preset.EnvironmentSpecularScale
	Lighting.ExposureCompensation = preset.ExposureCompensation
	Lighting.ShadowSoftness = preset.ShadowSoftness
	Lighting.GlobalShadows = true
	pcall(function() Lighting.ClockTime = preset.ClockTime end)
	applyPostFX(preset)
end

local function resolveMode(mode)
	mode = tostring(mode or R8_RTX.Mode or "auto"):lower()
	if mode == "day" then return "noon" end
	if PRESETS[mode] then return mode end
	local t = Lighting.ClockTime
	if t >= 5.5 and t < 7.5 then return "sunrise"
	elseif t >= 7.5 and t < 16.5 then return "noon"
	elseif t >= 16.5 and t < 19 then return "sunset"
	else return "night" end
end

local materialsApplied = false
local function applyMaterials()
	if materialsApplied or not R8_RTX.MaterialsEnabled then return end
	for _, c in ipairs(MaterialService:GetChildren()) do
		if c:IsA("MaterialVariant") and c.Name:match("^" .. TAG.MAT) then c:Destroy() end
	end
	local okN = 0
	for matName, data in pairs(VARIANTS) do
		local mat = Enum.Material[matName]
		if typeof(mat) == "EnumItem" then
			local variantName = TAG.MAT .. matName
			local v = Instance.new("MaterialVariant")
			v.Name = variantName
			v.BaseMaterial = mat
			if data.ColorMap and data.ColorMap ~= "" then v.ColorMap = data.ColorMap end
			if data.NormalMap and data.NormalMap ~= "" then v.NormalMap = data.NormalMap end
			if data.RoughnessMap and data.RoughnessMap ~= "" then v.RoughnessMap = data.RoughnessMap end
			if data.MetalnessMap and data.MetalnessMap ~= "" then v.MetalnessMap = data.MetalnessMap end
			if data.MaterialPattern then v.MaterialPattern = data.MaterialPattern end
			if data.StudsPerTile then v.StudsPerTile = data.StudsPerTile end
			v.Parent = MaterialService
			if pcall(function() MaterialService:SetBaseMaterialOverride(mat, variantName) end) then okN += 1 end
		end
	end
	materialsApplied = true
	vlog("Materials", okN)
end

local function clearMaterials()
	for matName in pairs(VARIANTS) do
		local mat = Enum.Material[matName]
		if typeof(mat) == "EnumItem" then
			pcall(function() MaterialService:ClearBaseMaterialOverride(mat) end)
		end
	end
	for _, c in ipairs(MaterialService:GetChildren()) do
		if c:IsA("MaterialVariant") and c.Name:match("^" .. TAG.MAT) then c:Destroy() end
	end
	materialsApplied = false
end

