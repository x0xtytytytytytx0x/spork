local function applyContactColorTint(candidateParts)
	if not R8_RTX.ContactColorEnabled then return end
	local COLOR_DISTANCE, DARKEN_AMOUNT, GRID_SIZE = 0.018, 0.16, 12
	local function isColorPart(part)
		if not part:IsA("BasePart") or part:IsA("Terrain") or part.Transparency ~= 0 then return false end
		if Players:GetPlayerFromCharacter(part.Parent) then return false end
		if part:FindFirstAncestorOfClass("Tool") then return false end
		return true
	end
	local function cellKey(pos)
		return math.floor(pos.X/GRID_SIZE)..":"..math.floor(pos.Y/GRID_SIZE)..":"..math.floor(pos.Z/GRID_SIZE)
	end
	local grid, parts = {}, {}
	for _, inst in ipairs(candidateParts) do
		if isColorPart(inst) then
			local k = cellKey(inst.Position)
			grid[k] = grid[k] or {}
			table.insert(grid[k], inst)
			table.insert(parts, inst)
		end
	end
	local processed = {}
	for index, a in ipairs(parts) do
		if a.Parent and not processed[a] then
			local ax = math.floor(a.Position.X/GRID_SIZE)
			local ay = math.floor(a.Position.Y/GRID_SIZE)
			local az = math.floor(a.Position.Z/GRID_SIZE)
			for x = ax-1, ax+1 do
				for y = ay-1, ay+1 do
					for z = az-1, az+1 do
						local nearby = grid[x..":"..y..":"..z]
						if nearby then
							for _, b in ipairs(nearby) do
								if b ~= a and b.Parent and not processed[b] and isColorPart(b) then
									local ca, cb = a.Color, b.Color
									if math.abs(ca.R-cb.R)<=COLOR_DISTANCE and math.abs(ca.G-cb.G)<=COLOR_DISTANCE and math.abs(ca.B-cb.B)<=COLOR_DISTANCE then
										local d = a.Position - b.Position
										local mx = (a.Size.X+b.Size.X)*0.5+0.05
										local my = (a.Size.Y+b.Size.Y)*0.5+0.05
										local mz = (a.Size.Z+b.Size.Z)*0.5+0.05
										if math.abs(d.X)<=mx and math.abs(d.Y)<=my and math.abs(d.Z)<=mz then
											b.Color = Color3.new(cb.R*(1-DARKEN_AMOUNT), cb.G*(1-DARKEN_AMOUNT), cb.B*(1-DARKEN_AMOUNT))
											processed[a], processed[b] = true, true
											break
										end
									end
								end
							end
						end
						if processed[a] then break end
					end
					if processed[a] then break end
				end
				if processed[a] then break end
			end
		end
		if index % R8_RTX.ColorBatchSize == 0 then RunService.Heartbeat:Wait() end
	end
end

local function collectWorkspaceTargets()
	local decalTargets, colorTargets, soundTargets = {}, {}, {}
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("BasePart") and inst.Parent then
			if inst:FindFirstAncestorOfClass("Model") then table.insert(decalTargets, inst) end
			table.insert(colorTargets, inst)
		elseif inst:IsA("Sound") then
			table.insert(soundTargets, inst)
		end
	end
	return decalTargets, colorTargets, soundTargets
end

local descendantConnection
local newInstanceBuffer, flushScheduled = {}, false
local function flushNewInstances()
	flushScheduled = false
	local batch = newInstanceBuffer
	newInstanceBuffer = {}
	for _, inst in ipairs(batch) do
		if inst.Parent then enqueueDecalTarget(inst) end
	end
	processDecalQueue()
end
local function handleNewInstance(inst)
	if inst:IsA("Sound") then
		if R8_RTX.DistanceMuffleEnabled then watchSoundLifecycle(inst) end
		return
	end
	if not inst:IsA("BasePart") then return end
	if R8_RTX.DecalsEnabled and inst:FindFirstAncestorOfClass("Model") then
		addToDecalGrid(inst)
		table.insert(newInstanceBuffer, inst)
		if not flushScheduled then
			flushScheduled = true
			task.delay(0.5, flushNewInstances)
		end
	end
end

function R8_RTX.SetMode(mode)
	mode = tostring(mode or "auto"):lower()
	if mode ~= "auto" and mode ~= "day" and not PRESETS[mode] then mode = "auto" end
	R8_RTX.Mode = mode
	if R8_RTX.LightingEnabled and R8_RTX.Applied then
		applyLightingPreset(resolveMode(mode))
	end
	return R8_RTX.Mode
end

function R8_RTX.SetOptions(opts)
	if type(opts) ~= "table" then return end
	if opts.DecalsEnabled ~= nil then R8_RTX.DecalsEnabled = opts.DecalsEnabled and true or false end
	if opts.MaterialsEnabled ~= nil then R8_RTX.MaterialsEnabled = opts.MaterialsEnabled and true or false end
	if opts.BloomEnabled ~= nil then R8_RTX.BloomEnabled = opts.BloomEnabled and true or false end
	if opts.ContactColorEnabled ~= nil then R8_RTX.ContactColorEnabled = opts.ContactColorEnabled and true or false end
	if opts.LightingEnabled ~= nil then R8_RTX.LightingEnabled = opts.LightingEnabled and true or false end
	if typeof(opts.MaxDecalInstances) == "number" then
		R8_RTX.MaxDecalInstances = math.clamp(math.floor(opts.MaxDecalInstances), 0, 50000)
	end
	if R8_RTX.Applied and R8_RTX.LightingEnabled then
		applyLightingPreset(resolveMode(R8_RTX.Mode))
	end
end

function R8_RTX.Apply(mode)
	if mode then R8_RTX.Mode = tostring(mode):lower() end
	if R8_RTX.Applied then
		R8_RTX.Revert()
	end
	R8_RTX.Applied = true

	if R8_RTX.LightingEnabled then
		applyLightingPreset(resolveMode(R8_RTX.Mode))
	end
	if R8_RTX.MaterialsEnabled then
		applyMaterials()
	end
	if R8_RTX.AudioEnabled then
		applyAudioEnhancements()
	end

	local decalTargets, colorTargets, soundTargets = collectWorkspaceTargets()

	if R8_RTX.DecalsEnabled then
		buildDecalGrid(decalTargets)
		task.spawn(decalRangeCheckLoop)
	end
	if R8_RTX.ContactColorEnabled then
		task.spawn(function()
			task.wait(2)
			applyContactColorTint(colorTargets)
		end)
	end
	if R8_RTX.DistanceMuffleEnabled then
		for _, s in ipairs(soundTargets) do watchSoundLifecycle(s) end
		task.spawn(muffleUpdateLoop)
	end
	if not descendantConnection then
		descendantConnection = Workspace.DescendantAdded:Connect(handleNewInstance)
	end
	return true
end

function R8_RTX.Revert()
	R8_RTX.Applied = false
	clearOwnedLighting()
	clearDecals()
	clearOwnedAudio()
	audioApplied = false
	clearMaterials()
	revertMuffling()
	if descendantConnection then
		descendantConnection:Disconnect()
		descendantConnection = nil
	end
	for part, connection in pairs(transparencyConnections) do
		pcall(function() connection:Disconnect() end)
		if part and part.Parent then part.LocalTransparencyModifier = 0 end
	end
	table.clear(transparencyConnections)
	table.clear(watchedParts)
	table.clear(decalQueue)
	table.clear(newInstanceBuffer)
	table.clear(decalGrid)
	decalQueueIndex = 1
	decalQueueRunning = false
	decalRangeLoopRunning = false
	flushScheduled = false
	return true
end

function R8_RTX.IsApplied()
	return R8_RTX.Applied == true
end

-- No auto-run — UI loads and calls Apply
if typeof(getgenv) == "function" then
	getgenv().R8_RTX = R8_RTX
	getgenv().R8X = R8_RTX
end
return R8_RTX
